# LM Studio (local LLM)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_MODEL=gemma-4-26B-A4B-it-MLX-8bit

# STT (local Whisper via mlx-whisper)
STT_LANGUAGE=ja

# Audio settings
VONAGE_AUDIO_RATE=16000

# --- Vonage (required) ---
VONAGE_APPLICATION_ID=your_application_id
VONAGE_PRIVATE_KEY=./private.key

# Optional: override public WebSocket URL
# Set this to your Cloudflare tunnel URL + /ws
# WS_URI=wss://your-tunnel.trycloudflare.com/ws

# --- Anam.ai (required) ---
ANAM_API_KEY=your_anam_api_key
ANAM_AVATAR_ID=your_avatar_id
ANAM_VOICE_ID=your_voice_id
